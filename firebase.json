{
  "hosting": {
    "site": "ilkspacedtcm",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/chat/me/**",
        "destination": "/chat/me/index.html"
      },
      {
        "source": "/chat/u/**",
        "destination": "/chat/u/index.html"
      },
      {
        "source": "/chat",
        "destination": "/chat/index.html"
      },
      {
        "source": "/about",
        "destination": "/about/index.html"
      },
      {
        "source": "/1.16.5",
        "destination": "/1.16.5/index.html"
      },
      {
        "source": "/tos",
        "destination": "/tos/index.html"
      },
      {
        "source": "/1.14.4",
        "destination": "/1.14.4/index.html"
      }
    ]
  }
}
